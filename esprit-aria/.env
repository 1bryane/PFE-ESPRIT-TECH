# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text

# Paramètres inférence
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_CTX_SIZE=8192
LLM_TOP_P=0.9
OLLAMA_TIMEOUT=180
STREAM=true

# RAG
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_THRESHOLD=0.60

# Mémoire
MEMORY_MAX_HISTORY=20
MEMORY_TOP_K=4
MEMORY_MIN_LENGTH=30

# API
API_HOST=0.0.0.0
API_PORT=8001
API_RELOAD=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Sécurité — CHANGER EN PRODUCTION
JWT_SECRET=esprit-aria-dev-secret-2026
JWT_EXPIRE_H=24

# Logs
LOG_LEVEL=INFO
